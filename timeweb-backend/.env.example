# Copy values into /etc/derzhava/backend.env on the server; never commit real secrets.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=derzhava
PGUSER=derzhava_app
PGPASSWORD=
ADMIN_TOKEN_SECRET=
PORT=3000
ALLOWED_ORIGINS=https://lulopuz.github.io

