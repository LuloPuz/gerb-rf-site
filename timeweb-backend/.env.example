CUSTOMER_AUTH_ENABLED=false
CUSTOMER_ORIGIN=
CUSTOMER_AUTH_SECRET=
SMS_AERO_EMAIL=
SMS_AERO_KEY=
SMS_AERO_SIGN=
SMS_DAILY_LIMIT=20
